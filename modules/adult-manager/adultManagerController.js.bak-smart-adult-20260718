      auto_frame_error = CASE
        WHEN EXCLUDED.auto_frame_url IS NOT NULL OR ai_adult_catalog.auto_frame_url IS NOT NULL THEN NULL
        ELSE COALESCE(EXCLUDED.auto_frame_error, ai_adult_catalog.auto_frame_error)
